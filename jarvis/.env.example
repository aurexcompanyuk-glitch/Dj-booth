# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# Your Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Protects your server (and your API key) when deployed publicly.
# Anyone using the HUD must enter this code under Configuration.
JARVIS_ACCESS_CODE=

# Optional tuning
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=low          # low | medium | high | xhigh | max (higher = smarter but slower to reply)
# JARVIS_DATA_DIR=data       # where long-term memory (memory.json) is stored
# PORT=3000
