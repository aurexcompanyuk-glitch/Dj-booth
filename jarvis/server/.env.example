# ── Jarvis AI Backend Config ──────────────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
#
# MODE: "hermes" | "openai" | "anthropic"
#   hermes    → spawns the `hermes` CLI (must be installed: https://hermes-agent.nousresearch.com)
#   openai    → calls OpenAI API directly
#   anthropic → calls Anthropic API directly
#
AI_MODE=hermes

# OpenAI (used when AI_MODE=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (used when AI_MODE=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Hermes model override (used when AI_MODE=hermes, optional)
# HERMES_MODEL=nous-hermes-3

# Server port
PORT=3001
